
*.ipynb
*.pyc
.ipynb_checkpoints/
# Globs, not paths: neither pattern contains a slash, so both match at any
# depth. They replace the per-directory spellings that used to be here, which
# named `src/` only — so `pip install -e clients/vfbquery-client` left its
# egg-info showing as untracked, which is build output a `git add -A` will
# happily commit. (`*.pyc` above already hides the compiled files; the
# `__pycache__/` entry is what keeps the directory out when it holds anything
# else.)
*.egg-info/
__pycache__/
build/
test_examples.py
test_results.py
.vscode
.pytest_cache
.venv
.vscode/settings.json
temp_examples_output.txt
json_block_*.json
.idea/
src/.DS_Store
